ENVIRONMENT=dev

DATABASE_URL=postgresql+psycopg://platform:platform@localhost:5432/platform

META_APP_ID=
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=change-me
GRAPH_VERSION=v23.0

# dev: any localstack-style value works since KmsEncryptor talks to localstack below.
# prod: real key ARN, created by infra/terraform/modules/secrets.
KMS_KEY_ID=alias/wa-platform-dev
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1

SQS_QUEUE_URL=http://localhost:4566/000000000000/wa-platform-dev-inbound
